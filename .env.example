# ─── Cloudflare R2 ───────────────────────────────────────────────────────────
CF_R2_BUCKET_NAME=apuntes-argentina
CF_R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
CF_R2_ACCESS_KEY_ID=
CF_R2_SECRET_ACCESS_KEY=
CF_R2_REGION=auto

# ─── Servidor Express ─────────────────────────────────────────────────────────
UPLOAD_PORT=3002

# ─── CORS — orígenes permitidos (separados por coma) ─────────────────────────
# En producción: tu dominio real
# En desarrollo: localhost con el puerto de Vite
ALLOWED_ORIGINS=https://apuntesargentina.ar,https://www.apuntesargentina.ar

# ─── Frontend (Vite) ──────────────────────────────────────────────────────────
# URL pública del backend en producción (Railway, Render, Fly.io, etc.)
VITE_API_URL=https://api.apuntesargentina.ar/api

# ─── Node environment ────────────────────────────────────────────────────────
NODE_ENV=production
